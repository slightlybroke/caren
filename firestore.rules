rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A user can read another user's check-in ONLY if:
    // 1. A mutual, approved family link exists
    // 2. The author has explicitly granted sharing permissions for that field
    function hasFamilyPermission(authorId, permissionField) {
      let linkPath = /databases/$(database)/documents/users/$(authorId)/family_links/$(request.auth.uid);
      return isAuthenticated() &&
             exists(linkPath) &&
             get(linkPath).data.status == 'approved' &&
             get(linkPath).data.permissions[permissionField] == true;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Explicit Family Relationships & Revocable Permissions
      match /family_links/{familyMemberId} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == familyMemberId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == familyMemberId);
      }

      // Privacy Settings (Strictly self-managed)
      match /settings/privacy {
        allow read, write: if isOwner(userId);
      }
    }

    // Daily Check-Ins (Family Experience)
    match /check_ins/{checkInId} {
      // Owner can read and write their own check-ins
      allow create, update, delete: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Family members can read only if sharing permission is active
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (
          resource.data.isSharedWithFamily == true &&
          hasFamilyPermission(resource.data.userId, 'shareCheckInStatus')
        )
      );
    }

    // Me Experience (Strictly Private Sanctuary)
    // NEVER accessible to family members or third parties
    match /users/{userId}/me_sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/personal_trends/{trendId} {
      allow read, write: if isOwner(userId);
    }

    // Assist Experience (Temporary Situations & Medical Handoffs)
    match /assist_sessions/{sessionId} {
      // Accessible to the person who initiated the assist session
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.createdBy == request.auth.uid
      );
    }
  }
}

